# ==========================================
# VGI Canteen Backend Configuration
# ==========================================

# Server Port
PORT=5000
PORT=5001
NODE_ENV=development

# Frontend Connection URL (For CORS & Sockets)
FRONTEND_URL=http://localhost:5173

# Neon DB (PostgreSQL) Connection String
# Get your connection string from https://console.neon.tech
# e.g.: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for user & admin authentication
JWT_SECRET=vgi_canteen_jwt_secret_key_super_secure_2026

# Razorpay Credentials (Optional for local test simulator mode)
# If left empty or as test dummy, backend automatically uses seamless Dev Sandbox simulator mode
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key
RAZORPAY_TEST_MODE=true

